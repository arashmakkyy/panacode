{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "panacode-local": {
      "path": "~/.local/share/panacode",
      "description": "Contains Panacode logs and data",
    },
  },
  "permissions": [
    { "action": "github-pr-search", "resource": "*", "effect": "deny" },
  ],
  "experimental": {
    "part_rows": true,
  },
}
